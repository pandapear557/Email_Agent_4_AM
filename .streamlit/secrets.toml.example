# 이 파일을 secrets.toml 로 복사해서 로컬 테스트에 쓰세요.
# Streamlit Cloud에서는 앱 설정 > Secrets 화면에 같은 내용을 붙여넣습니다.

# AI 제공자 키 — 쓰려는 것만 있으면 됩니다(둘 다 없어도 앱은 뜸).
GEMINI_API_KEY = "여기에-Gemini-키"      # 무료: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY = "sk-ant-여기에-키"   # 선택: https://console.anthropic.com

# 이력 영구 저장(Supabase). 없으면 앱은 그대로 뜨고 이력만 세션 한정.
# Supabase 대시보드 > Project Settings > API 에서 확인.
SUPABASE_URL = "https://여기-프로젝트.supabase.co"
SUPABASE_KEY = "여기에-anon-public-key"
